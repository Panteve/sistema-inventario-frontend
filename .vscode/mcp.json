{
  // For more information, visit: https://angular.dev/ai/mcp
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "console-ninja": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%/.console-ninja/mcp/"
      ]
    },
    "apexcharts": {
      "command": "npx",
      "args": ["-y", "apexcharts-mcp"]
    }
  
}
}
